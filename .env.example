# Copy this file to .env and fill in your Alpaca PAPER trading keys.
# Get them free at https://alpaca.markets (Paper Trading dashboard -> API Keys).
# Never commit your real .env file - it is ignored by git.
APCA_API_KEY_ID=your-paper-key-id
APCA_API_SECRET_KEY=your-paper-secret-key

# SEC EDGAR asks every caller to identify themselves (name + email) in the
# User-Agent. Used by ai_desk/fundamentals/edgar.py.
SEC_USER_AGENT=Your Name your-email@example.com
